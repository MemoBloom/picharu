# Copy to apps/web/.env.local for local Next.js. Vercel uses project environment variables.
# Server-only: never use NEXT_PUBLIC_ for credentials below.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
# Prefer the new server-only secret key; legacy JWT below remains a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IMAGE_RETENTION_DAYS=7
# Remain false until the reviewed Worker is implemented, integrated and evaluated.
GENERATION_ENABLED=false
MODEL_PROFILES_JSON=[]
# Optional; missing/unavailable JEV yields explicitly marked fallback recommendations.
JEV_BASE_URL=
JEV_SERVICE_SECRET=

# Browser-safe Supabase project configuration, set before the production build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported when the publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
