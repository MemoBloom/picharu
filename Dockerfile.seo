# Separate reporting job; never use the image-generation Worker's command or runtime identity.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/prompts/package.json packages/prompts/package.json
COPY packages/tool-config/package.json packages/tool-config/package.json
# tsx and GoogleAuth run the source CLI; include them explicitly even in a production image.
RUN npm ci --include=dev --workspaces --include-workspace-root && npm cache clean --force
COPY packages/ packages/
COPY apps/web/src/ apps/web/src/
COPY scripts/seo/ scripts/seo/
ENV NODE_ENV=production GENERATION_ENABLED=false SEO_RANK_API_ENABLED=false
USER node
ENTRYPOINT ["node","--import","tsx","scripts/seo/collect.ts"]
CMD ["--help"]
