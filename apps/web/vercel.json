{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci --include=dev --workspaces --include-workspace-root",
  "buildCommand": "npm run build",
  "regions": [
    "hnd1"
  ],
  "git": {
    "deploymentEnabled": {
      "fix/generation-test-allowlist": false,
      "main": false,
      "fix/image-preview-task-progress": false,
      "feat/automatic-worker-processing": false
    }
  }
}
